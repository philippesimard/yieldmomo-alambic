# ==============================================================================
#  ALAMBIC - GABARIT DE DEVELOPPEMENT LOCAL
# ==============================================================================
#
#  cp .env.local.exemple .env    puis    npm run dev
#
#  Rien a remplir pour demarrer : les valeurs ci-dessous suffisent. Les zones
#  Dokploy ne concernent que .env.production.exemple, qui suit le meme plan.
#
#  Une cle vide vaut « non definie » : ne rien commenter, ne rien retirer.


# ==============================================================================
#  LE FICHIER .env
# ==============================================================================


# --- Acces --------------------------------------------------------------------

# ALAMBIC_CLE
#   Vide en local : le service repond alors a tout le monde, ce qui n'est
#   acceptable qu'ici. Pour l'essayer : openssl rand -base64 32
ALAMBIC_CLE=

# SAUTS_PROXY
#   Proxys devant le service. 0 en local : rien devant.
SAUTS_PROXY=0


# --- Journalisation - OVHcloud Logs Data Platform -------------------------------

# JOURNAL_GELF_HOTE
#   Vide : les logs restent sur la sortie standard. Les renseigner le temps d'un
#   essai envoie bien les lignes chez OVH, marquees environnement:development.
JOURNAL_GELF_HOTE=

# JOURNAL_GELF_JETON
#   Exige des que l'hote est renseigne, sinon le demarrage est refuse.
JOURNAL_GELF_JETON=

# JOURNAL_GELF_PORT
#   Entree GELF en TCP/TLS. Laisser tel quel.
JOURNAL_GELF_PORT=12202


# --- Service --------------------------------------------------------------------

# NODE_ENV
#   development : moteurs factices permis, logs colores, hublot monte.
NODE_ENV=development

# HOST
#   Interface d'ecoute.
HOST=0.0.0.0

# PORT
#   3100 et non 3000 : l'api de YieldMomo occupe deja 3000 sur le meme poste.
PORT=3100

# LOG_LEVEL
#   debug en local : on veut tout voir.
LOG_LEVEL=debug

# MODE_MAINTENANCE
#   true met le service de cote sans l'eteindre : /distiller refuse en 503.
MODE_MAINTENANCE=false


# --- Traitement -----------------------------------------------------------------

# TAILLE_MAX_IMAGE
#   Taille maximale d'une image recue, en octets. 15 Mo.
TAILLE_MAX_IMAGE=15728640

# OUVRIERS
#   Distillations menees en parallele. Vide = un de moins que de coeurs.
OUVRIERS=

# DELAI_DISTILLATION_MS
#   Plafond par facture, en millisecondes. Doit rester strictement au-dessus de
#   DELAI_OCR_MS + DELAI_COLLECTE_MS, sinon le demarrage est refuse.
DELAI_DISTILLATION_MS=30000


# --- Lecture du texte (OCR) -----------------------------------------------------

# MOTEUR_OCR
#   paddleocr (sidecar python) ou factice (blocs inventes, aucune dependance).
#   Vide = factice. Installer le venv d'abord : voir packages/condensation.
MOTEUR_OCR=paddleocr

# DETECTION_OCR
#   Taille du modele de detection : mobile ou server. Voir le README.
DETECTION_OCR=mobile

# PORT_SIDECAR_OCR
#   Port local du moteur.
PORT_SIDECAR_OCR=3101

# DELAI_OCR_MS
#   Plafond d'une lecture, en millisecondes.
DELAI_OCR_MS=20000

# CHEMIN_PYTHON_OCR
#   Interpreteur qui execute le moteur. Vide = le venv du depot, cree avec uv
#   (packages/condensation/sidecar/.venv/bin/python).
CHEMIN_PYTHON_OCR=


# --- Identification des champs (collecte) ---------------------------------------

# MOTEUR_COLLECTE
#   lilt (sidecar python) ou factice (heuristique du total, aucune dependance).
#   Vide = factice. Installer le venv d'abord : voir packages/collecte.
MOTEUR_COLLECTE=lilt

# PORT_SIDECAR_COLLECTE
#   Port local du moteur.
PORT_SIDECAR_COLLECTE=3103

# DELAI_COLLECTE_MS
#   Plafond d'un etiquetage, en millisecondes.
DELAI_COLLECTE_MS=6000

# CHEMIN_PYTHON_COLLECTE
#   Interpreteur qui execute le moteur. Vide = le venv du depot
#   (packages/collecte/sidecar/.venv/bin/python).
CHEMIN_PYTHON_COLLECTE=

# MODELE_COLLECTE
#   Vide = le checkpoint public, en zero-shot sur un recu quebecois. Pour juger
#   le modele maison : outils/entrainement/modeles/lilt-alambic (chemin absolu).
#   En production cette cle se pose au build : voir .env.production.exemple.
MODELE_COLLECTE=


# ==============================================================================
#  CE QUI N'EST PAS DANS CE FICHIER
# ==============================================================================
#
#   MODELE_URL ................ argument de build, pas d'execution. Ne sert qu'a
#                               construire l'image de production.
#   AWS_ACCESS_KEY_ID .........\ les clefs du bucket restent hors du depot :
#   AWS_SECRET_ACCESS_KEY ...../ publier-modele les demande au clavier.
