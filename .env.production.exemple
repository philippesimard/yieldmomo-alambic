# ==============================================================================
#  ALAMBIC - GABARIT DE PRODUCTION
# ==============================================================================
#
#  Dokploy > application Alambic > onglet Environment. Deux zones de texte, dans
#  l'ordre de l'ecran : on copie un bloc, on le colle, on passe a la suivante.
#
#  LES TROIS SEULES VALEURS A PRODUIRE SOI-MEME :
#    1. ALAMBIC_CLE ....................... openssl rand -base64 32
#    2. JOURNAL_GELF_HOTE + _JETON ........ manager OVHcloud
#    3. MODELE_URL ........................ npm run publier-modele   (zone 2 !)
#  Tout le reste se colle tel quel.
#
#  Une cle vide vaut « non definie » : ne rien commenter, ne rien retirer du bloc.
#  La zone 2 n'apparait qu'avec General > Build Type = Dockerfile.


# ==============================================================================
#  ZONE 1 sur 2 - ENVIRONMENT SETTINGS
#  Ce que le service lit en tournant. Tout le bloc ci-dessous se colle ici.
# ==============================================================================


# --- Acces --------------------------------------------------------------------

# ALAMBIC_CLE                   [Environment Settings] · requis
#   Ferme le service : sans cle, quiconque connait l'adresse envoie des images.
#   Valeur : openssl rand -base64 32 — la meme que ALAMBIC_CLE cote yieldmomo.
ALAMBIC_CLE=

# SAUTS_PROXY                   [Environment Settings]
#   Proxys devant le service, pour compter l'ip du client et non celle du proxy.
#   Valeur : 1 — Traefik est le seul saut. Laisser tel quel.
SAUTS_PROXY=1


# --- Journalisation - OVHcloud Logs Data Platform -------------------------------

# JOURNAL_GELF_HOTE             [Environment Settings] · a remplir
#   Le cluster qui recoit les logs. Vide, ils ne quittent pas le conteneur.
#   Valeur : manager OVHcloud > « Configuration SSL », forme xxx.logs.ovh.com
JOURNAL_GELF_HOTE=

# JOURNAL_GELF_JETON            [Environment Settings] · a remplir
#   Dit a OVH dans quel flux ecrire. Exige des que l'hote est renseigne.
#   Valeur : le flux de donnees > menu « ... » > Copier le jeton d'ecriture.
JOURNAL_GELF_JETON=

# JOURNAL_GELF_PORT             [Environment Settings]
#   Entree GELF en TCP/TLS. Laisser tel quel.
JOURNAL_GELF_PORT=12202


# --- Service --------------------------------------------------------------------

# NODE_ENV                      [Environment Settings]
#   production : moteurs reels exiges, hublot absent, logs en json brut.
NODE_ENV=production

# HOST                          [Environment Settings]
#   Interface d'ecoute. 0.0.0.0 pour que le reseau du conteneur l'atteigne.
HOST=0.0.0.0

# PORT                          [Environment Settings]
#   Port d'ecoute. Doit valoir la meme chose que Domains > Container Port.
PORT=3100

# LOG_LEVEL                     [Environment Settings]
#   Verbosite des logs. info en production ; debug les rend bavards et couteux.
LOG_LEVEL=info

# MODE_MAINTENANCE              [Environment Settings]
#   true met le service de cote sans l'eteindre : /distiller refuse en 503.
#   Repasser a false apres la maintenance.
MODE_MAINTENANCE=false


# --- Traitement -----------------------------------------------------------------

# TAILLE_MAX_IMAGE              [Environment Settings]
#   Taille maximale d'une image recue, en octets. 15 Mo.
TAILLE_MAX_IMAGE=15728640

# OUVRIERS                      [Environment Settings]
#   Distillations menees en parallele. 2 sur cette machine ; ne monter qu'apres
#   mesure — voir « Dimensionnement » dans le README.
OUVRIERS=2

# DELAI_DISTILLATION_MS         [Environment Settings]
#   Plafond par facture, en millisecondes. Doit rester strictement au-dessus de
#   DELAI_OCR_MS + DELAI_COLLECTE_MS, sinon le demarrage est refuse.
DELAI_DISTILLATION_MS=30000


# --- Lecture du texte (OCR) -----------------------------------------------------

# MOTEUR_OCR                    [Environment Settings] · requis
#   Moteur qui lit le texte de l'image. Sans cette cle, demarrage refuse.
MOTEUR_OCR=paddleocr

# DETECTION_OCR                 [Environment Settings]
#   Taille du modele de detection. Ne pas changer — voir le README.
DETECTION_OCR=mobile

# PORT_SIDECAR_OCR              [Environment Settings]
#   Port local du moteur, jamais expose hors du conteneur.
PORT_SIDECAR_OCR=3101

# DELAI_OCR_MS                  [Environment Settings]
#   Plafond d'une lecture, en millisecondes.
DELAI_OCR_MS=20000


# --- Identification des champs (collecte) ---------------------------------------

# MOTEUR_COLLECTE               [Environment Settings] · requis
#   Moteur qui reconnait les champs d'une facture. Sans cette cle, demarrage
#   refuse.
MOTEUR_COLLECTE=lilt

# PORT_SIDECAR_COLLECTE         [Environment Settings]
#   Port local du moteur, jamais expose hors du conteneur.
PORT_SIDECAR_COLLECTE=3103

# DELAI_COLLECTE_MS             [Environment Settings]
#   Plafond d'un etiquetage, en millisecondes.
DELAI_COLLECTE_MS=6000

# Ne pas ajouter MODELE_COLLECTE ici : l'image la pose au build, et la saisir —
# meme vide — ecraserait cette valeur et refuserait le demarrage. Derniere
# section du fichier.


# ==============================================================================
#  ZONE 2 sur 2 - BUILD-TIME ARGUMENTS
#  Lu pendant le docker build seulement. La cle reste en COMMENTAIRE ici, pour
#  qu'un copier-coller du bloc du dessus ne l'emmene pas dans la zone 1.
# ==============================================================================
#
# MODELE_URL                    [Build-time Arguments] · requis
#   Fait entrer le modele maison (plus d'un Go) dans l'image au build : en
#   production rien ne se telecharge, aucune clef S3 ne touche le serveur.
#   Valeur : npm run publier-modele -- --bucket <bucket>
#            URL presignee, sept jours. Passe ce delai le build echoue en 403 ;
#            represigner avec --nom <objet.tar.gz> --url-seulement
#
#   MODELE_URL=https://...


# ==============================================================================
#  NE RIEN COLLER - L'IMAGE S'EN CHARGE
# ==============================================================================
#
# Deja posees par l'image docker. Les retaper n'ajoute rien, et le jour ou
# l'image change un chemin, c'est la valeur du tableau de bord qui gagnerait —
# fausse.
#
#   CHEMIN_PYTHON_OCR ......... /opt/ocr/bin/python
#   CHEMIN_PYTHON_COLLECTE .... /opt/collecte/bin/python
#   MODELE_COLLECTE ........... posee au build a partir de MODELE_URL. La saisir,
#                               meme vide, refuse le demarrage.
