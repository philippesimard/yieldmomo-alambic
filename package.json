{
  "name": "alambic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "tsx outils/preparer-sidecars.ts",
    "dev": "npm run dev --workspace=packages/api",
    "start": "npm run start --workspace=packages/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p outils/tsconfig.json --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "banc": "tsx outils/banc.ts",
    "banc:condensation": "tsx outils/banc-condensation.ts",
    "banc:collecte": "tsx outils/banc-collecte.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "typescript": "^6.0.3",
    "tsx": "^4.22.4"
  }
}
