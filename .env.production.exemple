# Gabarit de production. Renseigner ces cles dans le tableau de bord de deploiement.
#
# Les cles d'execution sont presentes et actives : une valeur vide vaut « non definie » (voir
# sansValeursVides dans packages/api/src/config/env.ts), donc rien a commenter ni decommenter
# en passant d'un gabarit a l'autre. Seule exception, MODELE_COLLECTE : l'image la renseigne
# au build, la reprendre ici l'ecraserait — la section 6 dit pourquoi.
#
# La section 7 n'est pas de l'environnement d'execution : elle se regle au build.

# --- 1. Execution ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

# Arret volontaire du service. `true` : /distiller refuse en 503, /ready passe en 503 pour que
# le load balancer retire l'instance, /health reste en 200 pour que personne ne la redemarre —
# un conteneur en maintenance ne doit pas etre redemarre en boucle. Vide ou `false` : service
# normal.
MODE_MAINTENANCE=false

# --- 2. Acces ---
# [requis] Secret partage avec l'api de YieldMomo, envoye dans l'en-tete x-cle-alambic.
#          Sans elle le demarrage est refuse : le service accepterait les images de
#          n'importe qui. 32 caracteres minimum, la meme valeur que ALAMBIC_CLE cote api.
#          Generer avec : openssl rand -base64 32
ALAMBIC_CLE=

# --- 3. Reseau ---
# Nombre de proxys de confiance devant le service (nginx, Dokploy). Sert a lire la vraie ip
# du client : sans ca, la limitation de debit compte tout le trafic sur l'ip du proxy. Ne
# jamais mettre plus de sauts que la realite, l'en-tete est falsifiable.
SAUTS_PROXY=1

# --- 4. Traitement ---
# Taille maximale d'une image recue, en octets. 15 Mo : une photo d'iPhone recent depasse
# souvent les 10 Mo, et la couper a la reception rendrait le service inutilisable.
TAILLE_MAX_IMAGE=15728640
# Nombre d'ouvriers dans l'atelier. Vide = un de moins que de coeurs alloues au conteneur.
# 2 et non le defaut : le sidecar ocr sert une seule instance sous verrou, et l'ocr pese plus
# de 95 % d'une distillation. Au-dela de deux ouvriers, le troisieme attend derriere les autres
# et finit en 504 — ce sont des delais qu'on ajoute, pas du debit. Ne remonter que si le
# condensationMs maximum des logs reste bien sous 10 s.
OUVRIERS=2
# Plafond par distillation, en millisecondes. Au-dela, l'ouvrier est tue et remplace.
DELAI_DISTILLATION_MS=30000

# --- 5. Moteur ocr ---
# [requis] Moteur de l'etape Condensation. `paddleocr` en production : `factice` invente des
#          blocs et ne sert qu'au developpement. Sans cette cle le demarrage est refuse.
MOTEUR_OCR=paddleocr
# Port local du sidecar paddleocr, jamais expose hors du conteneur.
PORT_SIDECAR_OCR=3101
# Plafond d'une lecture ocr, en millisecondes. Strictement sous DELAI_DISTILLATION_MS.
DELAI_OCR_MS=20000
# Interpreteur python qui execute le sidecar. L'image docker installe le sien dans /opt/ocr.
CHEMIN_PYTHON_OCR=/opt/ocr/bin/python
# Modele de detection paddleocr : `mobile` ou `server`. Mesure sur le corpus : server coute
# 4 a 6x la latence de mobile (16 s la photo simple, 83 s la plus dense) et depasse
# DELAI_OCR_MS. Le garder demanderait de pousser DELAI_DISTILLATION_MS au-dela de 85 s.
DETECTION_OCR=mobile

# --- 6. Moteur collecte ---
# [requis] Moteur de l'etape Collecte. `lilt` en production : `factice` ne reconnait que
#          le total par heuristique et ne sert qu'au developpement. Sans cette cle le
#          demarrage est refuse.
MOTEUR_COLLECTE=lilt
# Port local du sidecar d'etiquetage, jamais expose hors du conteneur.
PORT_SIDECAR_COLLECTE=3103
# Plafond d'un etiquetage, en millisecondes. DELAI_OCR_MS + DELAI_COLLECTE_MS doit rester
# strictement sous DELAI_DISTILLATION_MS.
DELAI_COLLECTE_MS=6000
# Interpreteur python qui execute le sidecar. L'image docker installe le sien dans
# /opt/collecte.
CHEMIN_PYTHON_COLLECTE=/opt/collecte/bin/python
# MODELE_COLLECTE n'apparait PAS ici, et c'est volontaire : l'image la renseigne elle-meme
# quand elle est construite avec MODELE_URL (voir la section 7). La definir dans le tableau
# de bord — meme vide — ecraserait cette valeur, et le demarrage serait refuse.

# --- 7. Build (tableau de bord Dokploy, pas l'environnement d'execution) ---
# Le checkpoint maison pese plus d'un Go : il vit sur un bucket compatible S3 et entre dans
# l'image AU BUILD. En production rien ne se telecharge, et aucune clef S3 ne descend sur le
# serveur. Deposer le modele avec : npm run publier-modele -- --bucket <bucket>
#
# La commande rend une URL presignee, valable sept jours. C'est elle, et rien d'autre, que le
# build recoit : Dokploy ne sait pas monter de secret de build, et une clef S3 passee en
# argument resterait lisible dans `docker history`. Une URL expiree, elle, ne vaut rien.
#
# Argument de build (onglet Environment > Build Time Arguments) :
#   MODELE_URL      l'URL rendue par publier-modele              [requis en production]
#
# Passe les sept jours l'image ne se reconstruira plus, et le message d'erreur du build sera un
# 403 de curl. Represigner sans rien televerser :
#   npm run publier-modele -- --bucket <bucket> --nom <objet.tar.gz> --url-seulement
