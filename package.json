{
  "name": "alambic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "tsx outils/preparer-sidecars.ts",
    "dev": "npm run dev --workspace=packages/api",
    "start": "npm run start --workspace=packages/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p outils/tsconfig.json --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "banc": "tsx outils/banc.ts",
    "banc:condensation": "tsx outils/banc-condensation.ts",
    "banc:collecte": "tsx outils/banc-collecte.ts",
    "mesure": "tsx outils/mesure.ts",
    "rejeu:categorie": "tsx outils/rejeu-categorie.ts",
    "generer-recus": "tsx outils/python.ts outils/recus/engendrer.py",
    "verifier-boites": "tsx outils/python.ts outils/recus/verifier_boites.py",
    "tester-recus": "tsx outils/python.ts -m pytest outils/recus",
    "entrainer-modele": "tsx outils/python.ts outils/entrainement/entrainement.py",
    "evaluer-modele": "tsx outils/python.ts outils/entrainement/evaluation.py",
    "publier-modele": "tsx outils/publier-modele.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@biomejs/biome": "^2.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
