# Gabarit de developpement local. Copier en .env a la racine du depot :
#   cp .env.local.exemple .env
#
# Toutes les cles sont presentes et actives : une valeur vide vaut « non definie » (voir
# sansValeursVides dans packages/api/src/config/env.ts), donc rien a commenter ni decommenter
# en passant d'un gabarit a l'autre.

# --- 1. Execution ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=debug

# --- 2. Acces ---
# [option] Secret partage avec l'api de YieldMomo, envoye dans l'en-tete x-cle-alambic.
#          Vide en local : le service repond alors a tout le monde, ce qui n'est acceptable
#          qu'ici. En production son absence refuse le demarrage.
#          Generer avec : openssl rand -base64 32
ALAMBIC_CLE=

# --- 3. Reseau ---
# Nombre de proxys de confiance devant le service. 0 en local : rien devant.
SAUTS_PROXY=0

# --- 4. Traitement ---
# Taille maximale d'une image recue, en octets. 15 Mo : une photo d'iPhone recent depasse
# souvent les 10 Mo, et la couper a la reception rendrait le service inutilisable.
TAILLE_MAX_IMAGE=15728640
# Nombre d'ouvriers dans l'atelier. Vide = un de moins que de coeurs, pour que le thread
# principal garde de quoi accepter les requetes.
OUVRIERS=
# Plafond par distillation, en millisecondes. Au-dela, l'ouvrier est tue et remplace.
DELAI_DISTILLATION_MS=30000

# --- 5. Moteur ocr ---
# Moteur de l'etape Condensation : `factice` (aucune dependance, blocs inventes) ou
# `paddleocr` (sidecar python — installer le venv d'abord, voir packages/condensation).
# Vide = factice ; en production la cle est requise.
MOTEUR_OCR=paddleocr
# Port local du sidecar paddleocr. 3101 : 3100 est l'api, 3000 l'api de YieldMomo.
PORT_SIDECAR_OCR=3101
# Plafond d'une lecture ocr, en millisecondes. Strictement sous DELAI_DISTILLATION_MS.
DELAI_OCR_MS=20000
# Interpreteur python qui execute le sidecar. Vide = le venv du depot
# (packages/condensation/sidecar/.venv/bin/python), cree avec uv — voir le README.
CHEMIN_PYTHON_OCR=
# Modele de detection paddleocr : `mobile` ou `server`. Mesure sur le corpus : server coute
# 4 a 6x la latence de mobile (16 s la photo simple, 83 s la plus dense) et depasse
# DELAI_OCR_MS. Le garder demanderait de pousser DELAI_DISTILLATION_MS au-dela de 85 s.
DETECTION_OCR=mobile
